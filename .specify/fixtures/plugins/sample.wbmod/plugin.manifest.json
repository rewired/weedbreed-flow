{
  "$schema": "../../../schemas/plugin.manifest.schema.json",
  "id": "example.basic",
  "name": "Basic Example Plugin",
  "description": "Provides a demo resource and node type for validation.",
  "version": "0.1.0",
  "wbSpecVersion": "0.1.0",
  "deterministic": true,
  "permissions": [],
