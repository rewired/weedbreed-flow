        "labor": { "opsPerHour": 0 },
        "maint": { "wearRatePerHour": 0.003 }
      }
    ]
  },
  "conflicts": { "provides": ["resource:energy", "nodeType:source.grid_tap"], "conflicts": [], "replaces": [] }
}

