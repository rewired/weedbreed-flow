{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wb://schemas/plugin.manifest.schema.json",
  "title": "WB Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "wbSpecVersion", "deterministic"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "wbSpecVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "deterministic": { "type": "boolean" },
    "permissions": { "type": "array", "items": { "type": "string" }, "default": [] },
    "contributions": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "resources": { "type": "array" },
        "nodeTypes": { "type": "array" },
        "markets": { "type": "array" },
        "uiSlices": { "type": "array" }
      }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "provides": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "replaces": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

