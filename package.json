{
  "name": "weedbreed-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "workspaces": [
    "apps/*",
    "packages/*",
    ".specify"
  ],
  "scripts": {
    "dev": "pnpm --filter @wb/apps-factory dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "validate:schemas": "ajv compile -s .specify/schemas/*.json",
    "validate:fixtures:graph": "ajv validate -s .specify/schemas/graph.schema.json -d .specify/fixtures/golden/graph.*.json --spec=draft2020",
    "validate:fixtures:plugin": "ajv validate -s .specify/schemas/plugin.manifest.schema.json -d .specify/fixtures/plugins/sample.wbmod/plugin.manifest.json --spec=draft2020",
    "validate:fixtures": "pnpm run validate:fixtures:graph && pnpm run validate:fixtures:plugin",
    "sim": "node .specify/scripts/node/simulate.mjs",
    "golden": "node .specify/scripts/node/golden.mjs",
    "validate": "pnpm run validate:schemas && pnpm run validate:fixtures && pnpm run golden"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1"
  }
}
